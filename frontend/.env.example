# Copie este arquivo para ".env.local" e ajuste os valores.
# (Opcional: sem .env.local, o "npm run dev" já usa o backend em http://localhost:8080.)
# Toda variável lida pelo frontend PRECISA começar com "VITE_".
# Nunca coloque senhas ou chaves secretas aqui: tudo que começa com VITE_
# vai parar no JavaScript que o navegador baixa.

# URL base do backend Spring Boot (sem barra no final e sem /api/v1)
VITE_API_URL=http://localhost:8080

# true  = usa dados de exemplo (src/mocks) e não chama o backend
# false = chama o backend de verdade
VITE_USE_MOCKS=false
