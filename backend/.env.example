# =====================================================================
# Variaveis de ambiente da Kaptu API
#
# Copie este arquivo para `.env` (que esta no .gitignore) e preencha
# localmente. NUNCA faça commit do `.env` nem de valores reais.
# =====================================================================

# Banco de dados (Supabase)
# Use o pooler em modo transacao (porta 6543) para evitar o limite de
# 15 clientes do modo sessao; mantenha sslmode=require.
# Se usar o pooler em modo transacao, acrescente &prepareThreshold=0 na URL.
DB_URL=jdbc:postgresql://SEU_HOST:6543/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=PASSWORD

# Schema: validate nao altera o banco. Use update somente em local.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Console H2 deve permanecer desligado em producao.
H2_CONSOLE_ENABLED=false
H2_CONSOLE_WEB_ALLOW_OTHERS=false

# Origens permitidas no CORS (separadas por virgula).
APP_CORS_ALLOWED_ORIGINS=https://seu-frontend.example

# Arquivos e OCR
KAPTU_PASTA_ARQUIVOS=./arquivos
KAPTU_OCR_TESSDATA=./tessdata

# Limites de upload
KAPTU_MAX_FILE_SIZE=10MB
KAPTU_MAX_REQUEST_SIZE=10MB
